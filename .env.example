# Copia este archivo como .env y completa los valores. NUNCA lo subas a un repositorio público.
APP_ENV=production            # production | local
APP_URL=https://logistica24-7.cl
APP_TZ=America/Punta_Arenas
SHOW_PROVISIONAL=true         # muestra marcas "texto provisional" en el sitio; poner false al publicar definitivamente
TRUST_PROXY=false             # true solo si hay un proxy/CDN de confianza delante

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# Correo saliente (SMTP corporativo)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=tls               # tls (587) | ssl (465) | none
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Sitio web Veinticuatrosiete
MAIL_TO=                      # destinatario de las consultas (varios separados por coma)

MAX_UPLOAD_MB=5
